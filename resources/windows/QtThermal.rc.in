#include <windows.h>

IDI_ICON1 ICON DISCARDABLE "@QTTHERMAL_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0x0L
    FILEOS 0x40004L
    FILETYPE 0x1L
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nita Vesa"
            VALUE "FileDescription", "QtThermal thermal camera viewer"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "QtThermal"
            VALUE "OriginalFilename", "QtThermal.exe"
            VALUE "ProductName", "QtThermal"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END